{
  "name": "gestao-financeira",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aplicativo web para gerenciar fluxo de caixa e balanço da empresa",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon server/index.js",
